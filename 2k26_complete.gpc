/*
- Auto Green
- Tempo Speed (ms)
- Stability Enhancer
- Turbo Shots
- RS Shooting
- Insta Shot
- Insta Speed (ms)
- Insta Tempo (ms)
- Remap Square
- Infinite Stamina (Fixed fade issue)
- Meter Dunk
- Normal Passing Fixed (R1 + Square)
- Auto Dribble
- Defense AI (NEW!)
- Save your inputs
Coming Next:
- Instant Stop
- Release Vibrator
- Instant Triggers
*/
int flick_sequences_enabled = 0;
int delay_duration = 50;
int Delay_duration_Insta = 50;
int STICK_DOWN_VALUE = 100;
int STICK_UP_VALUE = -100;
int RX_UP_VALUE = 25;
int random_variation_min = -4;
int random_variation_max = 4;
int random_hold_variation_min = -2;
int random_hold_variation_max = 2;
int stabilization_variation = 34;
int reverse_flick_mode = 1;
int rs_shooting_active = 0;
int rs_hold_duration = 300;
int Insta_shot_active = 1;
int Insta_shot_duration = 700;
int isHolding = 0;
int holdTimer = 0;
int rs_is_up = 0;
int remap_square_active = 0;

int flicked = 0;
int rs_down_active = 0;
int square_button = 0;
int square_shooting_in_progress = 0;
int rs_shooting_in_progress = 0;
int square_hold_timer = 0;
int pass_threshold = 150;

int meterDunkActive = 0;
int meterDunkComboRunning = 0;
int meterDunkOverrideActive = 0;
int meterDunkStartTime = 0;
int meterDunkDuration = 1000;
int current_time = 0;

int infinite_stamina = 0;
int ground_control = 70;
int ground_stick_active = 1;

// AUTO DRIBBLE VARIABLES
int dribble_enabled = 0;
int dribble_up_first_run = 1;

// DEFENSE AI VARIABLES (NEW)
int defense_assist = 0;

// Snow effect variables
int snow_enabled = 1;
int num_snowflakes = 30;
int snow_x[30];
int snow_y[30];
int snow_speed[30];
int snow_i;

// Idle screensaver state
int saver_on = 0;
int sx = 2, sy = 16;
int svx = 2, svy = 2;
int msg_w, line1_w, line2_w, line3_w;
int saver_timer = 0;
const string welcome_line1[] = { "I A M G O A T" };
const string welcome_line2[] = { "V7 Complete" };
const string welcome_line3[] = { "secretofscripts" };
const string saver_line1[] = { "IAMGOAT" };
const string saver_line2[] = { "V7 Complete" };
const string saver_line3[] = { "secretofscripts" };

// Menu state
int startup = 1, numpgs = 13, menu_enabled = 0, page = 1, menuSelection, toggleType, pageChg_s;
int flashtoggle, isXbox;

// Menu labels
const string menu_header[] = {
    "Auto Green", "Tempo Speed (ms)", "Stability Enhancer", "Turbo Shots",
    "RS Shooting", "Insta Shot", "Insta Speed (ms)", "Insta Tempo (ms)",
    "Remap Square", "Infinite Stamina", "Meter Dunk", "Auto Dribble", "Defense AI"
};
const string pageChg[] = {"---------L2+RIGHT->", "<-L2+LEFT--L2+RIGHT->", "<-L2+LEFT---------"};
const string item_toggle[] = {"L2 + UP/DOWN", "to change"};
const string onOff[] = {"OFF", "ON", "", "L3", "R3", "SQ"};
const string ms[] = {"ms"};
const string reverse_modes[] = {"Hop Jumper", "Turbo Fade"};

int isLoadingScreen = 1;
define LoadingTimer = 2000;
int LoadingTimeToRun = 0;

int graph_width, x_start, mid_x, bar_pos;
int is_turbo_fade = 0;
int flick_up_shooting_active = 1;

// Version check variables
int saved_version = 0;
int current_version = 7;
int first_time_flag = 0;

init {
    // Load settings with CORRECT parameter order: get_pvar(slot, min, max, default)

    flick_up_shooting_active = get_pvar(SPVAR_16, 0, 1, 1);         // Auto Green = ON
    delay_duration = get_pvar(SPVAR_17, 0, 300, 50);                // Tempo Speed = 50ms
    stabilization_variation = get_pvar(SPVAR_18, 10, 100, 50);      // Stability = 50
    reverse_flick_mode = get_pvar(SPVAR_19, 0, 1, 1);               // Turbo Fade = ON
    rs_shooting_active = get_pvar(SPVAR_20, 0, 1, 0);               // RS Shooting = OFF

    Insta_shot_active = get_pvar(SPVAR_21, 0, 1, 1);                // Insta Shot = ON
    Insta_shot_duration = get_pvar(SPVAR_22, 300, 1200, 700);       // Insta Shot Duration
    Delay_duration_Insta = get_pvar(SPVAR_23, 0, 300, 50);          // Insta Tempo = 50ms

    remap_square_active = get_pvar(SPVAR_24, 0, 2, 2);              // Remap Square = ON
    infinite_stamina = get_pvar(SPVAR_25, 0, 1, 0);                 // Infinite Stamina = OFF
    meterDunkActive = get_pvar(SPVAR_26, 0, 1, 0);                  // Meter Dunk = OFF
    dribble_enabled = get_pvar(SPVAR_27, 0, 1, 0);                  // Auto Dribble = OFF
    defense_assist = get_pvar(SPVAR_28, 0, 1, 0);                   // Defense AI = OFF (NEW)

    // Fixed values
    rs_hold_duration = 300;
    ground_control = 70;
    ground_stick_active = 1;
    saver_on = 0;
    saver_timer = 0;

    // Initialize snow positions
    for (snow_i = 0; snow_i < num_snowflakes; snow_i++) {
        snow_x[snow_i] = random(0, 127);
        snow_y[snow_i] = random(-20, 63);
        snow_speed[snow_i] = random(1, 3);
    }
}



main {
    if (get_console() == PIO_XB1) isXbox = 1;
    else isXbox = 0;

if (startup && isLoadingScreen) {
    cls_oled(OLED_BLACK);
    print(center_x(get_string_length(welcome_line1[0]), OLED_FONT_MEDIUM_WIDTH), 15, OLED_FONT_MEDIUM, OLED_WHITE, welcome_line1[0]);
    print(center_x(get_string_length(welcome_line2[0]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, welcome_line2[0]);
    print(center_x(get_string_length(welcome_line3[0]), OLED_FONT_SMALL_WIDTH), 45, OLED_FONT_SMALL, OLED_WHITE, welcome_line3[0]);

    // Draw snow on loading screen
    draw_snow();

    LoadingTimeToRun += get_rtime();
    if (LoadingTimeToRun >= LoadingTimer) {
        cls_oled(OLED_BLACK);
        isLoadingScreen = 0;
        startup = 0;
        saver_on = 1;
        saver_timer = 80;
    }
} else {
        combo_run(Movement_Control);

        if (event_press(PS4_CIRCLE) && menu_enabled) {
            menu_enabled = 0;
            combo_run(vibration_off);
            set_rgb(0,255,0);
            saver_on = 1;
        } else if (!menu_enabled && get_val(PS4_L2) && event_press(PS4_OPTIONS)) {
            menu_enabled = 1;
            page = 1;
            combo_run(vibration_on);
            set_rgb(0,0,255);
            saver_on = 0;
        }

        if (menu_enabled) {
            cls_oled(OLED_BLACK);
            rect_oled(0, 0, OLED_WIDTH, OLED_HEIGHT, OLED_BLACK, OLED_WHITE);
            line_oled(0, 15, OLED_WIDTH - 1, 15, 1, OLED_WHITE);
            print(center_x(get_string_length(menu_header[page - 1]), OLED_FONT_SMALL_WIDTH), 4, OLED_FONT_SMALL, OLED_WHITE, pageChg[pageChg_s]);
            print(center_x(get_string_length(menu_header[page - 1]), OLED_FONT_SMALL_WIDTH), 20, OLED_FONT_SMALL, OLED_WHITE, menu_header[page - 1]);

            if (page == 4) {
                print(center_x(get_string_length(reverse_modes[reverse_flick_mode]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, reverse_modes[reverse_flick_mode]);
            } else if (page == 9) {
                print(center_x(get_string_length(onOff[remap_square_active + 3]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, onOff[remap_square_active + 3]);
            } else if (page != 2 && page != 3 && page != 7 && page != 8) {
                print(center_x(get_string_length(onOff[menuSelection]), OLED_FONT_MEDIUM_WIDTH), 30, OLED_FONT_MEDIUM, OLED_WHITE, onOff[menuSelection]);
            }
            print(center_x(get_string_length(item_toggle[toggleType]), OLED_FONT_SMALL_WIDTH), 50, OLED_FONT_SMALL, OLED_WHITE, item_toggle[toggleType]);

if (page == 1) {
    pageChg_s = 0;
} else if (page == numpgs) {
    pageChg_s = 2;
} else {
    pageChg_s = 1;
}

if (page > numpgs) page = numpgs;
if (page < 1) page = 1;

            if (get_val(PS4_L2)) {
                set_val(PS4_UP,0); set_val(PS4_DOWN,0);
                set_val(PS4_LEFT,0); set_val(PS4_RIGHT,0);
            }
            if (get_val(PS4_L2) && event_press(PS4_LEFT)) { page--; combo_run(vibration_valchg); }
            if (get_val(PS4_L2) && event_press(PS4_RIGHT)) { page++; combo_run(vibration_valchg); }

            // Page 1: Auto Green
            if (page == 1) {
                menuSelection = flick_up_shooting_active;
                toggleType = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP)) {
                    flick_up_shooting_active = 1;
                    set_pvar(SPVAR_16, flick_up_shooting_active);
                    flashtoggle = 1;
                    combo_run(vibration_valchg);
                    combo_run(flashtog);
                }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) {
                    flick_up_shooting_active = 0;
                    set_pvar(SPVAR_16, flick_up_shooting_active);
                    flashtoggle = 0;
                    combo_run(vibration_valchg);
                    combo_run(flashtog);
                }
            }

            // Page 2: Tempo Speed
            if (page == 2) {
                menuSelection = 2;
                toggleType = 0;
                NumberToString(delay_duration, FindDigits(delay_duration));
                print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
                draw_x_graph(delay_duration, 0, 300, 45);
                if (get_val(PS4_L2)) {
                    if (event_press(PS4_UP)) delay_duration++;
                    if (event_press(PS4_DOWN)) delay_duration--;
                    if (event_press(PS4_UP) || event_press(PS4_DOWN)) {
                        set_pvar(SPVAR_17, delay_duration);
                        combo_run(vibration_valchg);
                        combo_run(flashedit);
                    }
                }
                if (delay_duration > 300) delay_duration = 300;
                if (delay_duration < 0) delay_duration = 0;
            }

            // Page 3: Stability Enhancer
            if (page == 3) {
                menuSelection = 2;
                toggleType = 0;
                NumberToString(stabilization_variation, FindDigits(stabilization_variation));
                print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
                draw_x_graph(stabilization_variation, 10, 100, 45);
                if (get_val(PS4_L2)) {
                    if (event_press(PS4_UP)) stabilization_variation++;
                    if (event_press(PS4_DOWN)) stabilization_variation--;
                    if (event_press(PS4_UP) || event_press(PS4_DOWN)) {
                        set_pvar(SPVAR_18, stabilization_variation);
                        combo_run(vibration_valchg);
                        combo_run(flashedit);
                    }
                }
                if (stabilization_variation > 100) stabilization_variation = 100;
                if (stabilization_variation < 10) stabilization_variation = 10;
            }

            // Page 4: Turbo Shots
            if (page == 4) {
                menuSelection = reverse_flick_mode;
                toggleType = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP)) {
                    reverse_flick_mode = 1;
                    set_pvar(SPVAR_19, reverse_flick_mode);
                    flashtoggle = 1;
                    combo_run(vibration_valchg);
                    combo_run(flashtog);
                }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) {
                    reverse_flick_mode = 0;
                    set_pvar(SPVAR_19, reverse_flick_mode);
                    flashtoggle = 0;
                    combo_run(vibration_valchg);
                    combo_run(flashtog);
                }
            }

            // Page 5: RS Shooting
            if (page == 5) {
                menuSelection = rs_shooting_active;
                toggleType = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP)) {
                    rs_shooting_active = 1;
                    set_pvar(SPVAR_20, rs_shooting_active);
                    flashtoggle = 1;
                    combo_run(vibration_valchg);
                    combo_run(flashtog);
                }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) {
                    rs_shooting_active = 0;
                    set_pvar(SPVAR_20, rs_shooting_active);
                    flashtoggle = 0;
                    combo_run(vibration_valchg);
                    combo_run(flashtog);
                }
            }

            // Page 6: Insta Shot
            if (page == 6) {
                menuSelection = Insta_shot_active;
                toggleType = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP)) {
                    Insta_shot_active = 1;
                    set_pvar(SPVAR_21, Insta_shot_active);
                    flashtoggle = 1;
                    combo_run(vibration_valchg);
                    combo_run(flashtog);
                }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) {
                    Insta_shot_active = 0;
                    set_pvar(SPVAR_21, Insta_shot_active);
                    flashtoggle = 0;
                    combo_run(vibration_valchg);
                    combo_run(flashtog);
                }
            }

            // Page 7: Insta Speed
            if (page == 7) {
                menuSelection = 2;
                toggleType = 0;
                NumberToString(Insta_shot_duration, FindDigits(Insta_shot_duration));
                print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
                draw_x_graph(Insta_shot_duration, 100, 1000, 45);
                if (get_val(PS4_L2)) {
                    if (get_val(PS4_R1)) {
                        if (event_press(PS4_UP)) Insta_shot_duration += 10;
                        if (event_press(PS4_DOWN)) Insta_shot_duration -= 10;
                    } else {
                        if (event_press(PS4_UP)) Insta_shot_duration += 1;
                        if (event_press(PS4_DOWN)) Insta_shot_duration -= 1;
                    }
                    if (event_press(PS4_UP) || event_press(PS4_DOWN)) {
                        set_pvar(SPVAR_22, Insta_shot_duration);
                        combo_run(vibration_valchg);
                        combo_run(flashedit);
                    }
                }
                if (Insta_shot_duration > 1000) Insta_shot_duration = 1000;
                if (Insta_shot_duration < 100) Insta_shot_duration = 100;
            }

            // Page 8: Insta Tempo
            if (page == 8) {
                menuSelection = 2;
                toggleType = 0;
                NumberToString(Delay_duration_Insta, FindDigits(Delay_duration_Insta));
                print(70, 30, OLED_FONT_MEDIUM, OLED_WHITE, ms[0]);
                draw_x_graph(Delay_duration_Insta, 0, 300, 45);
                if (get_val(PS4_L2)) {
                    if (event_press(PS4_UP)) Delay_duration_Insta++;
                    if (event_press(PS4_DOWN)) Delay_duration_Insta--;
                    if (event_press(PS4_UP) || event_press(PS4_DOWN)) {
                        set_pvar(SPVAR_23, Delay_duration_Insta);
                        combo_run(vibration_valchg);
                        combo_run(flashedit);
                    }
                }
                if (Delay_duration_Insta > 300) Delay_duration_Insta = 300;
                if (Delay_duration_Insta < 0) Delay_duration_Insta = 0;
            }

            // Page 9: Remap Square
            if (page == 9) {
                menuSelection = remap_square_active + 3;
                toggleType = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP)) {
                    remap_square_active++;
                    if (remap_square_active > 2) remap_square_active = 0;
                    set_pvar(SPVAR_24, remap_square_active);
                    flashtoggle = 1;
                    combo_run(vibration_valchg);
                    combo_run(flashtog);
                }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) {
                    remap_square_active--;
                    if (remap_square_active < 0) remap_square_active = 2;
                    set_pvar(SPVAR_24, remap_square_active);
                    flashtoggle = 0;
                    combo_run(vibration_valchg);
                    combo_run(flashtog);
                }
            }

            // Page 10: Infinite Stamina
            if (page == 10) {
                menuSelection = infinite_stamina;
                toggleType = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP)) {
                    infinite_stamina = 1;
                    set_pvar(SPVAR_25, infinite_stamina);
                    flashtoggle = 1;
                    combo_run(vibration_valchg);
                    combo_run(flashtog);
                }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) {
                    infinite_stamina = 0;
                    set_pvar(SPVAR_25, infinite_stamina);
                    flashtoggle = 0;
                    combo_run(vibration_valchg);
                    combo_run(flashtog);
                }
            }

            // Page 11: Meter Dunk
            if (page == 11) {
                menuSelection = meterDunkActive;
                toggleType = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP)) {
                    meterDunkActive = 1;
                    set_pvar(SPVAR_26, meterDunkActive);
                    flashtoggle = 1;
                    combo_run(vibration_valchg);
                    combo_run(flashtog);
                }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) {
                    meterDunkActive = 0;
                    set_pvar(SPVAR_26, meterDunkActive);
                    flashtoggle = 0;
                    combo_run(vibration_valchg);
                    combo_run(flashtog);
                }
            }

            // Page 12: Auto Dribble
            if (page == 12) {
                menuSelection = dribble_enabled;
                toggleType = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP)) {
                    dribble_enabled = 1;
                    set_pvar(SPVAR_27, dribble_enabled);
                    flashtoggle = 1;
                    combo_run(vibration_valchg);
                    combo_run(flashtog);
                }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) {
                    dribble_enabled = 0;
                    set_pvar(SPVAR_27, dribble_enabled);
                    flashtoggle = 0;
                    combo_run(vibration_valchg);
                    combo_run(flashtog);
                }
            }

            // Page 13: Defense AI (NEW)
            if (page == 13) {
                menuSelection = defense_assist;
                toggleType = 0;
                if (get_val(PS4_L2) && event_press(PS4_UP)) {
                    defense_assist = 1;
                    set_pvar(SPVAR_28, defense_assist);
                    flashtoggle = 1;
                    combo_run(vibration_valchg);
                    combo_run(flashtog);
                }
                if (get_val(PS4_L2) && event_press(PS4_DOWN)) {
                    defense_assist = 0;
                    set_pvar(SPVAR_28, defense_assist);
                    flashtoggle = 0;
                    combo_run(vibration_valchg);
                    combo_run(flashtog);
                }
            }

            // Draw snow effect on menu
            draw_snow();

        } // END MENU

        // GAMEPLAY LOGIC (NO MENU)
        if (!menu_enabled) {
            set_rgb(0,255,0);

            if (saver_on) {
                saver_timer += get_rtime();
                if (saver_timer >= 80) {
                    saver_step();
                    // Draw snow on screensaver
                    draw_snow();
                    saver_timer = 0;
                }
            }

            // Update current time
            current_time += get_rtime();

// Meter Dunk (Hold Circle + R2 only - NOT with L2)
if (meterDunkActive && get_val(PS4_CIRCLE) && get_val(PS4_R2) && !get_val(PS4_L2)) {
    if (!meterDunkComboRunning) {
        combo_run(meter_dunk_combo);
        meterDunkComboRunning = 1;
        meterDunkOverrideActive = 1;
        meterDunkStartTime = current_time;
    }
} else {
    if (meterDunkComboRunning && (!get_val(PS4_CIRCLE) || !get_val(PS4_R2) || (current_time - meterDunkStartTime) >= meterDunkDuration)) {
        combo_stop(meter_dunk_combo);
        meterDunkComboRunning = 0;
        meterDunkOverrideActive = 0;
    }
}

            // AUTO DRIBBLE LOGIC
            if (dribble_enabled) {
                if (get_val(PS4_UP)) {
                    set_val(PS4_UP, 0);
                    if (dribble_up_first_run) {
                        combo_run(dribble_up_initial);
                        dribble_up_first_run = 0;
                    } else {
                        combo_run(dribble_up_loop);
                    }
                } else {
                    combo_stop(dribble_up_initial);
                    combo_stop(dribble_up_loop);
                    dribble_up_first_run = 1;
                }

                if (get_val(PS4_RIGHT)) {
                    set_val(PS4_RIGHT, 0);
                    combo_run(dribble_right);
                } else {
                    combo_stop(dribble_right);
                }

                if (get_val(PS4_DOWN)) {
                    set_val(PS4_DOWN, 0);
                    combo_run(dribble_down);
                } else {
                    combo_stop(dribble_down);
                }

                if (get_val(PS4_LEFT)) {
                    set_val(PS4_LEFT, 0);
                    combo_run(dribble_left);
                } else {
                    combo_stop(dribble_left);
                }
            }

            // DEFENSE AI LOGIC (NEW)
            if (defense_assist) {
                if (get_val(PS4_L2) > 50) {
                    set_val(PS4_RY, (get_val(PS4_RY) * 13) / 10);
                }
            }

            // L3/R3/SQ Remap Logic
            if (remap_square_active == 0) {
                if (get_val(PS4_L3)) set_val(PS4_SQUARE, 100);
            } else if (remap_square_active == 1) {
                if (get_val(PS4_R3)) set_val(PS4_SQUARE, 100);
            }
            // If remap_square_active == 2 (SQ), Square stays as Square (no remap)

            // Detect Square press for turbo fade flag
            if (event_press(PS4_SQUARE) && !(remap_square_active == 0 && get_val(PS4_L3)) && !(remap_square_active == 1 && get_val(PS4_R3))) {
                if (reverse_flick_mode && get_val(PS4_R2)) {
                    is_turbo_fade = 1;
                } else {
                    is_turbo_fade = 0;
                }
            }

            // Auto Green (flick-up)
            if (flick_up_shooting_active) {
                // Only activate auto green if R1 is NOT being held when Square is pressed/held
                // This allows: R1 held + Square = pass, Square alone = auto green
                if (!(remap_square_active == 0 && get_val(PS4_L3)) && !(remap_square_active == 1 && get_val(PS4_R3)) && get_val(PS4_SQUARE)) {
                    // Check if R2 is being held RIGHT NOW for turbo fade (not just at press time)
                    if (reverse_flick_mode && get_val(PS4_R2) > 20) {
                        is_turbo_fade = 1;
                    } else {
                        is_turbo_fade = 0;
                    }

                    // If R1 is being held, let Square pass through for passing
                    if (!get_val(PS4_R1)) {
                        set_val(PS4_SQUARE, 0);
                        square_shooting_in_progress = 1;
                        if (is_turbo_fade) {
                            set_val(PS4_RY, STICK_UP_VALUE + random(random_variation_min, random_variation_max));
                        } else {
                            set_val(PS4_RY, STICK_DOWN_VALUE + random(random_variation_min, random_variation_max));
                        }
                        set_val(PS4_RX, random(random_variation_min, random_variation_max));
                    }
                }
                if (!(remap_square_active == 0 && get_val(PS4_L3)) && !(remap_square_active == 1 && get_val(PS4_R3)) && event_release(PS4_SQUARE)) {
                    // Square released
                    if (square_shooting_in_progress) {
                        // Was shooting - run the flick
                        if (is_turbo_fade) {
                            combo_run(flick_up_rs_reversed);
                        } else {
                            combo_run(flick_up_rs_smooth);
                        }
                        square_shooting_in_progress = 0;
                        is_turbo_fade = 0;
                    }
                }
            }

            // Insta Shot
            if (Insta_shot_active) {
                if ((remap_square_active == 0 && event_press(PS4_R3)) || (remap_square_active == 1 && event_press(PS4_L3))) {
                    if (reverse_flick_mode && get_val(PS4_R2)) {
                        combo_run(Insta_shot_reversed);
                    } else {
                        combo_run(Insta_shot_smooth);
                    }
                }
            }

            // RS Shooting
            if (rs_shooting_active) {
                if (!(get_val(PS4_L2) > 20 && (get_val(PS4_R1) > 20 || get_val(PS4_LEFT) || get_val(PS4_RIGHT) || get_val(PS4_UP) || get_val(PS4_DOWN) || get_val(PS4_OPTIONS)))) {
                    if (abs(get_val(PS4_RY)) > 30 || abs(get_val(PS4_RX)) > 30) {
                        if (!isHolding) {
                            isHolding = 1;
                            rs_shooting_in_progress = 1;
                            holdTimer = 0;
                            if (get_val(PS4_RY) < 0) {
                                rs_is_up = 1;
                            } else {
                                rs_is_up = 0;
                            }
                        }
                        holdTimer += get_rtime();
                    } else {
                        if (isHolding) {
                            if (holdTimer > rs_hold_duration) {
                                if (!rs_is_up) {
                                    combo_run(flick_up_rs_smooth);
                                } else {
                                    combo_run(flick_up_rs_reversed);
                                }
                            }
                            isHolding = 0;
                            rs_shooting_in_progress = 0;
                            holdTimer = 0;
                        }
                    }
                }
            }

        }
    }
}

// INFINITE STAMINA COMBO - FIXED TO ALLOW FADE AND PASSING
combo Movement_Control {
    // Only apply movement control if:
    // 1. Infinite stamina is enabled
    // 2. Ground stick is active
    // 3. NOT doing meter dunk
    // 4. NOT actively shooting (Square or RS shooting)
    // 5. NOT holding Square (for passing)
    if (infinite_stamina && ground_stick_active && !meterDunkOverrideActive &&
        !square_shooting_in_progress && !rs_shooting_in_progress && !get_val(PS4_SQUARE) &&
        !combo_running(flick_up_rs_smooth) && !combo_running(flick_up_rs_reversed) &&
        !combo_running(Insta_shot_smooth) && !combo_running(Insta_shot_reversed)) {
        if(abs(get_val(PS4_LX)) > 20 || abs(get_val(PS4_LY)) > 20) {
            set_val(PS4_LX, (get_val(PS4_LX) * ground_control) / 100);
            set_val(PS4_LY, (get_val(PS4_LY) * ground_control) / 100);
        }

        if(abs(get_val(PS4_LX)) < 20 && abs(get_val(PS4_LY)) < 20) {
            set_val(PS4_LX, 0);
            set_val(PS4_LY, 0);
        }
    }
}

combo meter_dunk_combo {
    set_val(PS4_RY, 100);
    set_val(PS4_R2, 100);
    wait(1000);
    set_val(PS4_RY, 0);
    set_val(PS4_R2, 0);
}


// SHOOTING COMBOS
combo flick_up_rs_smooth {
    set_val(PS4_RY, -50 + random(random_hold_variation_min, random_hold_variation_max));
    set_val(PS4_RX, 20 + random(random_hold_variation_min, random_hold_variation_max));
    wait(delay_duration);
    set_val(PS4_RY, -100 + random(random_variation_min, random_variation_max));
    set_val(PS4_RX, 25 + random(random_variation_min, random_variation_max));
    wait(300);
    set_val(PS4_RY, 0);
    set_val(PS4_RX, 0);
}

combo flick_up_rs_reversed {
    set_val(PS4_RY, 50 + random(random_hold_variation_min, random_hold_variation_max));
    set_val(PS4_RX, -20 + random(random_hold_variation_min, random_hold_variation_max));
    wait(delay_duration);
    set_val(PS4_RY, 100 + random(random_variation_min, random_variation_max));
    set_val(PS4_RX, -25 + random(random_variation_min, random_variation_max));
    wait(300);
    set_val(PS4_RY, 0);
    set_val(PS4_RX, 0);
}

combo Insta_shot_smooth {
    set_val(PS4_RY, STICK_DOWN_VALUE + random(random_variation_min, random_variation_max));
    set_val(PS4_RX, random(random_variation_min, random_variation_max));
    wait(Insta_shot_duration);
    set_val(PS4_RY, -50 + random(random_hold_variation_min, random_hold_variation_max));
    set_val(PS4_RX, 20 + random(random_hold_variation_min, random_hold_variation_max));
    wait(Delay_duration_Insta);
    set_val(PS4_RY, -100 + random(random_variation_min, random_variation_max));
    set_val(PS4_RX, 25 + random(random_variation_min, random_variation_max));
    wait(300);
    set_val(PS4_RY, 0);
    set_val(PS4_RX, 0);
}

combo Insta_shot_reversed {
    set_val(PS4_RY, STICK_UP_VALUE + random(random_variation_min, random_variation_max));
    set_val(PS4_RX, random(random_variation_min, random_variation_max));
