//@version=5
strategy("Liquidity Sweep Day Trading (5m)",
     overlay=true,
     initial_capital=10000,
     default_qty_type=strategy.percent_of_equity,
     default_qty_value=100,
     commission_type=strategy.commission.percent,
     commission_value=0.06,
     slippage=2,
     margin_long=100,
     margin_short=100)

// ============================================================================
// USER INPUTS
// ============================================================================

// === Risk Management ===
riskPercentInput = input.float(1.0, "Risk Per Trade (%)", minval=0.1, maxval=5.0, step=0.1, group="Risk Management")
riskRewardRatio = input.float(2.0, "Risk:Reward Ratio", minval=1.0, maxval=5.0, step=0.1, group="Risk Management")
useTrailingStop = input.bool(true, "Use Trailing Stop After 1R", group="Risk Management")
trailActivationR = input.float(1.0, "Trail Activation (R multiplier)", minval=0.5, maxval=3.0, step=0.1, group="Risk Management")
trailOffset = input.float(0.5, "Trail Offset (R multiplier)", minval=0.1, maxval=2.0, step=0.1, group="Risk Management")

// === Stop Loss Mode ===
stopLossMode = input.string("Sweep Level", "Stop Loss Mode", options=["Sweep Level", "ATR-Based"], group="Risk Management")
atrMultiplier = input.float(1.5, "ATR Multiplier (if ATR mode)", minval=0.5, maxval=5.0, step=0.1, group="Risk Management")
atrPeriod = input.int(14, "ATR Period", minval=5, maxval=50, group="Risk Management")

// === Session Settings ===
sessionInput = input.string("0930-1600", "Trading Session (Exchange Time)", group="Session Settings")
sweepThreshold = input.float(0.15, "Sweep Threshold (%)", minval=0.05, maxval=1.0, step=0.05, group="Session Settings",
     tooltip="How far price must exceed session level to qualify as a sweep")
reentryCandles = input.int(10, "Max Candles for Re-entry", minval=3, maxval=30, group="Session Settings",
     tooltip="Price must re-enter range within this many candles")

// === Regime Filter (ADX) ===
adxPeriod = input.int(14, "ADX Period", minval=5, maxval=50, group="Regime Filter")
adxMeanReversionMax = input.float(20, "ADX Max for Mean Reversion", minval=10, maxval=30, step=1, group="Regime Filter")
adxTrendMin = input.float(25, "ADX Min for Trend Continuation", minval=20, maxval=40, step=1, group="Regime Filter")

// === Higher Timeframe Trend ===
htfTimeframe = input.timeframe("60", "Higher Timeframe", group="Trend Filter")
htfEmaLength = input.int(20, "HTF EMA Length", minval=5, maxval=200, group="Trend Filter")

// === Volume Filter ===
volumePeriod = input.int(20, "Volume MA Period", minval=5, maxval=100, group="Volume Filter")
volumeMultiplier = input.float(1.0, "Volume Must Be > X * Average", minval=0.5, maxval=3.0, step=0.1, group="Volume Filter")

// === Candle Structure ===
minBodyRatio = input.float(0.5, "Min Body/Range Ratio", minval=0.3, maxval=0.9, step=0.1, group="Candle Structure",
     tooltip="Body must be at least this fraction of the full candle range")

// === Time Filters ===
useLondonSession = input.bool(true, "Trade London Session (03:00-11:00 ET)", group="Time Filters")
useNYSession = input.bool(true, "Trade NY Session (09:30-16:00 ET)", group="Time Filters")

// === Visual Settings ===
showSessionLevels = input.bool(true, "Show Session High/Low", group="Visual")
showSweepMarkers = input.bool(true, "Show Sweep Markers", group="Visual")

// ============================================================================
// FUNCTIONS
// ============================================================================

// Calculate ADX
calcADX(len) =>
    up = ta.change(high)
    down = -ta.change(low)
    plusDM = na(up) ? na : (up > down and up > 0 ? up : 0)
    minusDM = na(down) ? na : (down > up and down > 0 ? down : 0)
    trueRange = ta.tr

    smoothedTR = ta.rma(trueRange, len)
    smoothedPlusDM = ta.rma(plusDM, len)
    smoothedMinusDM = ta.rma(minusDM, len)

    plusDI = 100 * smoothedPlusDM / smoothedTR
    minusDI = 100 * smoothedMinusDM / smoothedTR

    dx = 100 * math.abs(plusDI - minusDI) / (plusDI + minusDI)
    adx = ta.rma(dx, len)
    [adx, plusDI, minusDI]

// Check if candle has strong bullish structure
isBullishStructure(minRatio) =>
    candleRange = high - low
    candleBody = close - open
    candleRange > 0 and candleBody > 0 and (candleBody / candleRange) >= minRatio

// Check if candle has strong bearish structure
isBearishStructure(minRatio) =>
    candleRange = high - low
    candleBody = open - close
    candleRange > 0 and candleBody > 0 and (candleBody / candleRange) >= minRatio

// ============================================================================
// SESSION TRACKING
// ============================================================================

// Detect new session
t = time(timeframe.period, sessionInput)
isNewSession = ta.change(t) != 0

// Track session high and low
var float sessionHigh = na
var float sessionLow = na
var int sessionStartBar = na

if isNewSession
    sessionHigh := high
    sessionLow := low
    sessionStartBar := bar_index
else if not na(sessionHigh)
    sessionHigh := math.max(sessionHigh, high)
    sessionLow := math.min(sessionLow, low)

// ============================================================================
// LIQUIDITY SWEEP DETECTION
// ============================================================================

// Calculate sweep threshold in price
sweepDistance = (high - low) * sweepThreshold / 100

// Detect sweep of session high
var bool highSwept = false
var int highSweepBar = na
var float highSweepLevel = na

if not na(sessionHigh) and not highSwept
    if high > sessionHigh + sweepDistance
        highSwept := true
        highSweepBar := bar_index
        highSweepLevel := sessionHigh

// Reset sweep if new session
if isNewSession
    highSwept := false
    highSweepBar := na
    highSweepLevel := na

// Detect sweep of session low
var bool lowSwept = false
var int lowSweepBar = na
var float lowSweepLevel = na

if not na(sessionLow) and not lowSwept
    if low < sessionLow - sweepDistance
        lowSwept := true
        lowSweepBar := bar_index
        lowSweepLevel := sessionLow

// Reset sweep if new session
if isNewSession
    lowSwept := false
    lowSweepBar := na
    lowSweepLevel := na

// ============================================================================
// RE-ENTRY DETECTION
// ============================================================================

// Check if price has re-entered range after high sweep (bearish setup)
reenteredAfterHighSweep = highSwept and
     not na(highSweepBar) and
     (bar_index - highSweepBar) <= reentryCandles and
     close < sessionHigh

// Check if price has re-entered range after low sweep (bullish setup)
reenteredAfterLowSweep = lowSwept and
     not na(lowSweepBar) and
     (bar_index - lowSweepBar) <= reentryCandles and
     close > sessionLow

// ============================================================================
// REGIME FILTER (ADX)
// ============================================================================

[adxValue, plusDI, minusDI] = calcADX(adxPeriod)

// Mean reversion regime: ADX is low (ranging market)
isMeanReversionRegime = adxValue < adxMeanReversionMax

// Trend continuation regime: ADX is high (trending market)
isTrendContinuationRegime = adxValue > adxTrendMin

// Dead zone: between thresholds - no trades
isDeadZone = not isMeanReversionRegime and not isTrendContinuationRegime

// ============================================================================
// HIGHER TIMEFRAME TREND FILTER
// ============================================================================

htfEma = request.security(syminfo.tickerid, htfTimeframe, ta.ema(close, htfEmaLength), lookahead=barmerge.lookahead_off)
htfClose = request.security(syminfo.tickerid, htfTimeframe, close, lookahead=barmerge.lookahead_off)

// Simple trend detection: price above/below HTF EMA
htfBullish = htfClose > htfEma
htfBearish = htfClose < htfEma

// ============================================================================
// VOLUME FILTER
// ============================================================================

volumeMA = ta.sma(volume, volumePeriod)
volumeConfirmed = volume > (volumeMA * volumeMultiplier)

// ============================================================================
// TIME FILTERS
// ============================================================================

// London session: 03:00-11:00 ET (08:00-16:00 UTC)
londonSession = time(timeframe.period, "0300-1100")
inLondonSession = not na(londonSession)

// NY session: 09:30-16:00 ET (14:30-21:00 UTC)
nySession = time(timeframe.period, "0930-1600")
inNYSession = not na(nySession)

// Combined time filter
timeFilterOK = (useLondonSession and inLondonSession) or (useNYSession and inNYSession)

// ============================================================================
// ENTRY CONDITIONS
// ============================================================================

// LONG Setup: Low swept, price re-entered, bullish structure, HTF bullish, volume confirmed
longSetup = reenteredAfterLowSweep and
     isMeanReversionRegime and
     htfBullish and
     isBullishStructure(minBodyRatio) and
     volumeConfirmed and
     timeFilterOK and
     strategy.position_size == 0

// SHORT Setup: High swept, price re-entered, bearish structure, HTF bearish, volume confirmed
shortSetup = reenteredAfterHighSweep and
     isMeanReversionRegime and
     htfBearish and
     isBearishStructure(minBodyRatio) and
     volumeConfirmed and
     timeFilterOK and
     strategy.position_size == 0

// ============================================================================
// RISK MANAGEMENT & POSITION SIZING
// ============================================================================

// Calculate ATR for dynamic stops
atrValue = ta.atr(atrPeriod)

// For LONG trades
var float longStopLoss = na
var float longTakeProfit = na

if longSetup
    // Determine stop loss
    if stopLossMode == "Sweep Level"
        longStopLoss := lowSweepLevel - sweepDistance
    else
        longStopLoss := close - (atrValue * atrMultiplier)

    // Calculate risk per share
    riskPerShare = close - longStopLoss

    // Position sizing based on fixed fractional risk
    accountRisk = strategy.equity * (riskPercentInput / 100)
    positionSize = accountRisk / riskPerShare

    // Calculate take profit
    longTakeProfit := close + (riskPerShare * riskRewardRatio)

    // Enter long
    strategy.entry("Long", strategy.long, qty=positionSize)
    strategy.exit("Long Exit", "Long",
         stop=longStopLoss,
         limit=longTakeProfit,
         comment="Exit Long")

// For SHORT trades
var float shortStopLoss = na
var float shortTakeProfit = na

if shortSetup
    // Determine stop loss
    if stopLossMode == "Sweep Level"
        shortStopLoss := highSweepLevel + sweepDistance
    else
        shortStopLoss := close + (atrValue * atrMultiplier)

    // Calculate risk per share
    riskPerShare = shortStopLoss - close

    // Position sizing based on fixed fractional risk
    accountRisk = strategy.equity * (riskPercentInput / 100)
    positionSize = accountRisk / riskPerShare

    // Calculate take profit
    shortTakeProfit := close - (riskPerShare * riskRewardRatio)

    // Enter short
    strategy.entry("Short", strategy.short, qty=positionSize)
    strategy.exit("Short Exit", "Short",
         stop=shortStopLoss,
         limit=shortTakeProfit,
         comment="Exit Short")

// ============================================================================
// TRAILING STOP (OPTIONAL)
// ============================================================================

if useTrailingStop and strategy.position_size > 0
    // Calculate current profit in R
    entryPrice = strategy.position_avg_price
    currentRisk = entryPrice - longStopLoss
    currentProfit = close - entryPrice
    currentR = currentProfit / currentRisk

    // Activate trailing stop after specified R
    if currentR >= trailActivationR
        trailStopPrice = close - (currentRisk * trailOffset)
        strategy.exit("Long Trail", "Long",
             stop=trailStopPrice,
             limit=longTakeProfit,
             comment="Trail Long")

if useTrailingStop and strategy.position_size < 0
    // Calculate current profit in R
    entryPrice = strategy.position_avg_price
    currentRisk = shortStopLoss - entryPrice
    currentProfit = entryPrice - close
    currentR = currentProfit / currentRisk

    // Activate trailing stop after specified R
    if currentR >= trailActivationR
        trailStopPrice = close + (currentRisk * trailOffset)
        strategy.exit("Short Trail", "Short",
             stop=trailStopPrice,
             limit=shortTakeProfit,
             comment="Trail Short")

// ============================================================================
// PLOTTING
// ============================================================================

// Plot session levels
plot(showSessionLevels ? sessionHigh : na, "Session High", color=color.red, linewidth=1, style=plot.style_linebr)
plot(showSessionLevels ? sessionLow : na, "Session Low", color=color.green, linewidth=1, style=plot.style_linebr)

// Plot HTF EMA on chart
plot(htfEma, "HTF EMA", color=color.new(color.blue, 50), linewidth=2)

// Plot sweep markers
plotshape(showSweepMarkers and highSwept and bar_index == highSweepBar,
     "High Swept",
     shape.triangledown,
     location.abovebar,
     color=color.red,
     size=size.small)

plotshape(showSweepMarkers and lowSwept and bar_index == lowSweepBar,
     "Low Swept",
     shape.triangleup,
     location.belowbar,
     color=color.green,
     size=size.small)

// Plot entry signals
plotshape(longSetup, "Long Entry", shape.labelup, location.belowbar, color=color.new(color.green, 0), text="LONG", textcolor=color.white, size=size.normal)
plotshape(shortSetup, "Short Entry", shape.labeldown, location.abovebar, color=color.new(color.red, 0), text="SHORT", textcolor=color.white, size=size.normal)

// Background color for regime
bgcolor(isMeanReversionRegime ? color.new(color.green, 95) :
     isTrendContinuationRegime ? color.new(color.blue, 95) :
     color.new(color.gray, 95), title="Regime Filter")

// ============================================================================
// ALERTS
// ============================================================================

alertcondition(longSetup, title="Long Entry Signal", message="Liquidity Sweep Long Setup on {{ticker}}")
alertcondition(shortSetup, title="Short Entry Signal", message="Liquidity Sweep Short Setup on {{ticker}}")

// ============================================================================
// INFO TABLE (OPTIONAL)
// ============================================================================

if barstate.islast
    var table infoTable = table.new(position.top_right, 2, 6, border_width=1)

    table.cell(infoTable, 0, 0, "ADX", bgcolor=color.new(color.gray, 80), text_color=color.white)
    table.cell(infoTable, 1, 0, str.tostring(adxValue, "#.##"), bgcolor=color.new(color.gray, 80), text_color=color.white)

    table.cell(infoTable, 0, 1, "Regime", bgcolor=color.new(color.gray, 80), text_color=color.white)
    table.cell(infoTable, 1, 1,
         isMeanReversionRegime ? "Mean Rev" :
         isTrendContinuationRegime ? "Trend" : "Dead Zone",
         bgcolor=color.new(color.gray, 80),
         text_color=isMeanReversionRegime ? color.green :
                    isTrendContinuationRegime ? color.blue : color.orange)

    table.cell(infoTable, 0, 2, "HTF Trend", bgcolor=color.new(color.gray, 80), text_color=color.white)
    table.cell(infoTable, 1, 2, htfBullish ? "Bullish" : "Bearish",
         bgcolor=color.new(color.gray, 80),
         text_color=htfBullish ? color.green : color.red)

    table.cell(infoTable, 0, 3, "High Swept", bgcolor=color.new(color.gray, 80), text_color=color.white)
    table.cell(infoTable, 1, 3, highSwept ? "Yes" : "No",
         bgcolor=color.new(color.gray, 80),
         text_color=highSwept ? color.red : color.white)

    table.cell(infoTable, 0, 4, "Low Swept", bgcolor=color.new(color.gray, 80), text_color=color.white)
    table.cell(infoTable, 1, 4, lowSwept ? "Yes" : "No",
         bgcolor=color.new(color.gray, 80),
         text_color=lowSwept ? color.green : color.white)

    table.cell(infoTable, 0, 5, "Volume OK", bgcolor=color.new(color.gray, 80), text_color=color.white)
    table.cell(infoTable, 1, 5, volumeConfirmed ? "Yes" : "No",
         bgcolor=color.new(color.gray, 80),
         text_color=volumeConfirmed ? color.green : color.red)
