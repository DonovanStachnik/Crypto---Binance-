//@version=6
strategy("SuperTrend 4H Scaler - Research-Backed",
         shorttitle="ST 4H Scale",
         overlay=true,
         initial_capital=10000,
         default_qty_type=strategy.percent_of_equity,
         default_qty_value=25,  // Larger position for compounding
         commission_type=strategy.commission.percent,
         commission_value=0.1,
         slippage=3,
         pyramiding=0,
         calc_on_every_tick=false,
         calc_on_order_fills=false)

// ==================================================================================
// SUPERTREND 4H SCALER - PROVEN STRATEGY FOR FAST SCALING
// ==================================================================================
// Based on research showing 155% profit in 2 months on BTC
// Key: Low win rate (40-50%) + High R:R (3:1 to 5:1) = Fast scaling
// Philosophy: Let winners run, cut losers quick
// ==================================================================================

// ==================================================================================
// INPUTS
// ==================================================================================

// SuperTrend Settings (Proven defaults from research)
int atrPeriod = input.int(10, "ATR Period", minval=5, maxval=20, group="SuperTrend")
float atrMultiplier = input.float(3.0, "ATR Multiplier", minval=1.0, maxval=5.0, step=0.5, group="SuperTrend")

// Risk Management - Designed for SCALING
float stopMultiplier = input.float(1.0, "Stop Loss (ATR Multiplier)", minval=0.5, maxval=2.0, step=0.5, group="Risk")
float targetMultiplier = input.float(4.0, "Profit Target (ATR Multiplier)", minval=2.0, maxval=8.0, step=0.5, group="Risk")
bool useTrailing = input.bool(true, "Trail Stop After 2:1 R:R", group="Risk")
float trailStart = input.float(2.0, "Trail Start (R:R Ratio)", minval=1.0, maxval=3.0, step=0.5, group="Risk")

// Position Sizing (For compounding/scaling)
bool compoundGains = input.bool(true, "Compound Gains (% of equity)", group="Position Sizing")
float positionSize = input.float(25, "Position Size %", minval=10, maxval=50, step=5, group="Position Sizing")

// Optional Filter
bool useADXFilter = input.bool(true, "Use ADX Trend Filter", group="Filters")
int minADX = input.int(20, "Minimum ADX", minval=15, maxval=35, group="Filters")

// ==================================================================================
// SUPERTREND CALCULATION
// ==================================================================================

atr = ta.atr(atrPeriod)
hl2Avg = hl2

upperBand = hl2Avg + (atrMultiplier * atr)
lowerBand = hl2Avg - (atrMultiplier * atr)

var float supertrend = na
var int direction = 1

// Calculate SuperTrend
prevSupertrend = nz(supertrend[1], lowerBand)
prevDirection = nz(direction[1], 1)

if prevDirection == 1
    supertrend := lowerBand
else
    supertrend := upperBand

// Update direction
if close > prevSupertrend
    direction := 1
else if close < prevSupertrend
    direction := -1
else
    direction := prevDirection

// Recalculate based on new direction
if direction == 1
    supertrend := lowerBand
else
    supertrend := upperBand

// Keep SuperTrend from flipping too much
if direction == 1 and prevDirection == 1
    supertrend := math.max(supertrend, prevSupertrend)
else if direction == -1 and prevDirection == -1
    supertrend := math.min(supertrend, prevSupertrend)

// ==================================================================================
// TREND FILTER (OPTIONAL)
// ==================================================================================

[plusDI, minusDI, adx] = ta.dmi(14, 14)
trendFilter = useADXFilter ? adx > minADX : true

// ==================================================================================
// ENTRY & EXIT SIGNALS
// ==================================================================================

// Buy Signal: SuperTrend flips bullish
buySignal = direction == 1 and prevDirection == -1 and trendFilter
bullish = direction == 1

// Sell Signal: SuperTrend flips bearish
sellSignal = direction == -1 and prevDirection == 1
bearish = direction == -1

// ==================================================================================
// POSITION MANAGEMENT - DESIGNED FOR SCALING
// ==================================================================================

var float entryPrice = na
var float stopLoss = na
var float profitTarget = na
var bool trailActivated = false
var int tradeNumber = 0

// Entry
if buySignal and strategy.position_size == 0
    entryPrice := close
    stopLoss := close - (atr * stopMultiplier)
    profitTarget := close + (atr * targetMultiplier)
    trailActivated := false
    tradeNumber += 1

    // Entry with position sizing
    comment = "BUY #" + str.tostring(tradeNumber) + " | ADX:" + str.tostring(math.round(adx))
    strategy.entry("Long", strategy.long, comment=comment)

// Exit Management
if strategy.position_size > 0
    // Calculate current R:R
    currentProfit = close - entryPrice
    riskAmount = entryPrice - stopLoss
    currentRR = riskAmount > 0 ? currentProfit / riskAmount : 0

    // Activate trailing stop after hitting target R:R
    if useTrailing and not trailActivated and currentRR >= trailStart
        trailActivated := true

    // Update trailing stop
    if trailActivated
        newStop = close - (atr * stopMultiplier * 1.5)  // Wider trail
        if newStop > stopLoss
            stopLoss := newStop

    // Exit on SuperTrend flip
    if sellSignal
        strategy.close("Long", comment="ST Flip")
        trailActivated := false

    // Stop loss and target
    strategy.exit("Exit", "Long",
                 stop=stopLoss,
                 limit=profitTarget,
                 comment="Exit")

// ==================================================================================
// VISUALIZATION
// ==================================================================================

// SuperTrend Line
plot(supertrend, "SuperTrend",
     color=direction == 1 ? color.new(color.green, 0) : color.new(color.red, 0),
     linewidth=3)

// Color bars based on trend
barcolor(direction == 1 ? color.new(color.green, 70) :
         direction == -1 ? color.new(color.red, 70) : na)

// Entry/Exit Signals
plotshape(buySignal, "BUY", shape.triangleup, location.belowbar,
         color.new(color.lime, 0), size=size.large, text="BUY")
plotshape(sellSignal and strategy.position_size > 0, "SELL", shape.triangledown,
         location.abovebar, color.new(color.red, 0), size=size.normal, text="EXIT")

// Background
bgcolor(direction == 1 and trendFilter ? color.new(color.green, 95) : na, title="Bullish Trend")
bgcolor(direction == -1 ? color.new(color.red, 97) : na, title="Bearish")
bgcolor(useADXFilter and adx < minADX ? color.new(color.orange, 97) : na, title="Weak Trend")

// ==================================================================================
// STATISTICS TABLE - TRACK SCALING PERFORMANCE
// ==================================================================================

var table statsTable = table.new(position.top_right, 2, 7,
                                 bgcolor=color.new(color.black, 85),
                                 border_width=2)

if barstate.islast
    // Header
    table.cell(statsTable, 0, 0, "SCALER STATS",
              text_color=color.white, bgcolor=color.new(color.blue, 50),
              text_size=size.normal)
    table.cell(statsTable, 1, 0, "Value",
              text_color=color.white, bgcolor=color.new(color.blue, 50))

    // Current Trend
    trendText = direction == 1 ? "BULL" : "BEAR"
    trendColor = direction == 1 ? color.new(color.green, 50) : color.new(color.red, 50)
    table.cell(statsTable, 0, 1, "Trend", text_color=color.white)
    table.cell(statsTable, 1, 1, trendText, text_color=color.white, bgcolor=trendColor)

    // ADX
    adxColor = adx > minADX ? color.new(color.green, 50) : color.new(color.orange, 50)
    table.cell(statsTable, 0, 2, "ADX", text_color=color.white)
    table.cell(statsTable, 1, 2, str.tostring(math.round(adx)),
              text_color=color.white, bgcolor=adxColor)

    // Position
    posText = strategy.position_size > 0 ? "LONG" : "None"
    posColor = strategy.position_size > 0 ? color.new(color.blue, 50) : color.new(color.gray, 70)
    table.cell(statsTable, 0, 3, "Position", text_color=color.white)
    table.cell(statsTable, 1, 3, posText, text_color=color.white, bgcolor=posColor)

    // Trade Number
    table.cell(statsTable, 0, 4, "Trades", text_color=color.white)
    table.cell(statsTable, 1, 4, str.tostring(tradeNumber), text_color=color.white)

    // Current R:R (if in position)
    if strategy.position_size > 0
        currentProfit = close - entryPrice
        riskAmount = entryPrice - stopLoss
        currentRR = riskAmount > 0 ? currentProfit / riskAmount : 0
        rrText = str.tostring(currentRR, "#.##") + ":1"
        rrColor = currentRR >= trailStart ? color.new(color.green, 50) : color.new(color.yellow, 50)
        table.cell(statsTable, 0, 5, "Current R:R", text_color=color.white)
        table.cell(statsTable, 1, 5, rrText, text_color=color.white, bgcolor=rrColor)

        // Trail Status
        trailText = trailActivated ? "ACTIVE" : "Waiting"
        trailColor = trailActivated ? color.new(color.green, 50) : color.new(color.gray, 70)
        table.cell(statsTable, 0, 6, "Trail Stop", text_color=color.white)
        table.cell(statsTable, 1, 6, trailText, text_color=color.white, bgcolor=trailColor)
    else
        table.cell(statsTable, 0, 5, "R:R", text_color=color.white)
        table.cell(statsTable, 1, 5, "N/A", text_color=color.gray)
        table.cell(statsTable, 0, 6, "Trail", text_color=color.white)
        table.cell(statsTable, 1, 6, "N/A", text_color=color.gray)

// ==================================================================================
// ENTRY/EXIT LABELS WITH DETAILS
// ==================================================================================

if buySignal
    buyText = "BUY #" + str.tostring(tradeNumber)
    label.new(bar_index, low * 0.995, text=buyText, color=color.new(color.green, 0), textcolor=color.white, style=label.style_label_up, size=size.normal)

if sellSignal and strategy.position_size > 0
    finalProfit = close - entryPrice
    riskAmount = entryPrice - stopLoss
    finalRR = riskAmount > 0 ? finalProfit / riskAmount : 0
    exitText = "EXIT"
    exitColor = finalRR > 0 ? color.new(color.blue, 0) : color.new(color.red, 0)
    label.new(bar_index, high * 1.005, text=exitText, color=exitColor, textcolor=color.white, style=label.style_label_down, size=size.normal)

// ==================================================================================
// ALERTS
// ==================================================================================

alertcondition(buySignal, "SuperTrend Buy", "SuperTrend BUY Signal - Enter Long")
alertcondition(sellSignal, "SuperTrend Sell", "SuperTrend SELL Signal - Exit Long")
alertcondition(trailActivated, "Trail Activated", "Trailing stop activated at 2:1 R:R")
